# SaaS Status app configuration (copy to .env or export in your environment)
PORT=8080
DB_PATH=./data/status.db
POLL_INTERVAL_MS=300000
FETCH_TIMEOUT_MS=20000
# Optional: require this header on /api/* (set to the header your SSO reverse
# proxy injects after authentication, e.g. x-auth-user). Leave unset for
# headerless local/trusted-network operation.
# AUTH_HEADER=x-auth-user

# Alerting (optional). Either point ALERTS_CONFIG at a JSON file
# (see alerts.example.json) for per-team subscriptions, or set a single
# default subscription via one/both webhook URLs below.
# ALERTS_CONFIG=./alerts.json
# ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/T000/B000/XXXX
# ALERT_WEBHOOK_URL=https://example.com/your-webhook
# DASHBOARD_URL=https://status.internal.example.com

# Boards (optional): named vendor sets for the board switcher.
# BOARDS_CONFIG=./boards.json

# Uptime samples retention (days of 5-minute poll samples kept for /api/uptime).
# UPTIME_RETENTION_DAYS=90
